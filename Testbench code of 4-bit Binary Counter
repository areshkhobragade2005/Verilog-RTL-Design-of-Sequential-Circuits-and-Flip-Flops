`timescale 1ns/1ps

module counter_tb;

reg clk;
reg reset;
wire [3:0] q;

// Instantiate the counter
counter uut (
    .clk(clk),
    .reset(reset),
    .q(q)
);

// Clock generation (10 ns period)
always #5 clk = ~clk;

initial
begin
    clk = 0;
    reset = 1;

    // Apply reset
    #10 reset = 0;

    // Run the counter
    #160;

    $finish;
end

endmodule
